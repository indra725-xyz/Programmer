<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rule-Based AI Chatbot</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      padding: 20px;
    }

    .chat-container {
      width: 100%;
      max-width: 650px;
      height: 700px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background: #ffffff;
      border-radius: 18px;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    }

    .chat-header {
      padding: 24px;
      color: white;
      background: #312e81;
      text-align: center;
    }

    .chat-header h1 {
      margin-bottom: 8px;
      font-size: 1.7rem;
    }

    .chat-header p {
      color: #c7d2fe;
      font-size: 0.95rem;
    }

    .chat-box {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      background: #f8fafc;
    }

    .message {
      display: flex;
      margin-bottom: 16px;
    }

    .message.bot {
      justify-content: flex-start;
    }

    .message.user {
      justify-content: flex-end;
    }

    .message-content {
      max-width: 78%;
      padding: 12px 16px;
      border-radius: 16px;
      line-height: 1.5;
      white-space: pre-line;
    }

    .bot .message-content {
      color: #1e293b;
      background: #e0e7ff;
      border-bottom-left-radius: 4px;
    }

    .user .message-content {
      color: white;
      background: #4f46e5;
      border-bottom-right-radius: 4px;
    }

    .chat-form {
      display: flex;
      gap: 10px;
      padding: 18px;
      border-top: 1px solid #e2e8f0;
      background: white;
    }

    .chat-input {
      flex: 1;
      padding: 13px 15px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      outline: none;
      font-size: 1rem;
    }

    .chat-input:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }

    .send-button {
      padding: 0 22px;
      border: none;
      border-radius: 10px;
      color: white;
      background: #4f46e5;
      font-weight: bold;
      cursor: pointer;
    }

    .send-button:hover {
      background: #3730a3;
    }

    .send-button:disabled,
    .chat-input:disabled {
      cursor: not-allowed;
      opacity: 0.6;
    }

    .suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 12px 18px;
      background: #f1f5f9;
    }

    .suggestion-button {
      padding: 8px 12px;
      border: 1px solid #c7d2fe;
      border-radius: 20px;
      color: #3730a3;
      background: white;
      cursor: pointer;
    }

    .suggestion-button:hover {
      background: #e0e7ff;
    }

    @media (max-width: 600px) {
      .chat-container {
        height: 90vh;
      }

      .message-content {
        max-width: 90%;
      }

      .chat-form {
        padding: 12px;
      }

      .send-button {
        padding: 0 16px;
      }
    }
  </style>
</head>
<body>
  <div class="chat-container">
    <header class="chat-header">
      <h1>Rule-Based AI Chatbot</h1>
      <p>Ask me something using predefined commands.</p>
    </header>

    <div class="chat-box" id="chatBox">
      <div class="message bot">
        <div class="message-content">
          Hello! I am a rule-based chatbot. Type "help" to see what I can do.
        </div>
      </div>
    </div>

    <div class="suggestions">
      <button class="suggestion-button" data-message="Hello">Hello</button>
      <button class="suggestion-button" data-message="How are you?">How are you?</button>
      <button class="suggestion-button" data-message="What is your name?">Your name</button>
      <button class="suggestion-button" data-message="Help">Help</button>
      <button class="suggestion-button" data-message="Bye">Exit</button>
    </div>

    <form class="chat-form" id="chatForm">
      <input
        type="text"
        id="userInput"
        class="chat-input"
        placeholder="Type your message..."
        autocomplete="off"
        required
      />
      <button type="submit" class="send-button" id="sendButton">
        Send
      </button>
    </form>
  </div>

  <script>
    const chatBox = document.getElementById("chatBox");
    const chatForm = document.getElementById("chatForm");
    const userInput = document.getElementById("userInput");
    const sendButton = document.getElementById("sendButton");
    const suggestionButtons = document.querySelectorAll(".suggestion-button");

    let chatbotActive = true;

    function addMessage(message, sender) {
      const messageElement = document.createElement("div");
      messageElement.className = `message ${sender}`;

      const contentElement = document.createElement("div");
      contentElement.className = "message-content";
      contentElement.textContent = message;

      messageElement.appendChild(contentElement);
      chatBox.appendChild(messageElement);

      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function getBotResponse(input) {
      const message = input.toLowerCase().trim();

      /*
        Rule-based decision-making using if-else logic.
      */

      if (
        message === "hello" ||
        message === "hi" ||
        message === "hey" ||
        message.includes("good morning") ||
        message.includes("good afternoon")
      ) {
        return "Hello! Nice to meet you. How can I help you?";
      } else if (
        message.includes("how are you") ||
        message.includes("how do you feel")
      ) {
        return "I am doing great! Thank you for asking.";
      } else if (
        message.includes("your name") ||
        message.includes("who are you")
      ) {
        return "My name is RuleBot. I am a simple rule-based chatbot.";
      } else if (
        message.includes("what can you do") ||
        message === "help" ||
        message.includes("help me")
      ) {
        return `I can respond to simple commands.

Try asking:
- Hello
- How are you?
- What is your name?
- What can you do?
- What time is it?
- Thank you
- Bye`;
      } else if (
        message.includes("time")
      ) {
        return `The current time is ${new Date().toLocaleTimeString()}.`;
      } else if (
        message.includes("date")
      ) {
        return `Today's date is ${new Date().toLocaleDateString()}.`;
      } else if (
        message.includes("thank")
      ) {
        return "You are welcome!";
      } else if (
        message === "bye" ||
        message === "goodbye" ||
        message === "exit" ||
        message === "quit"
      ) {
        chatbotActive = false;
        return "Goodbye! Refresh the page if you want to chat again.";
      } else {
        return "I do not understand that yet. Type 'help' to see the commands I understand.";
      }
    }

    function sendMessage(message) {
      if (!chatbotActive || message.trim() === "") {
        return;
      }

      addMessage(message, "user");

      const response = getBotResponse(message);

      setTimeout(() => {
        addMessage(response, "bot");

        if (!chatbotActive) {
          userInput.disabled = true;
          sendButton.disabled = true;
        }
      }, 400);
    }

    chatForm.addEventListener("submit", function(event) {
      event.preventDefault();

      const message = userInput.value.trim();

      if (message !== "") {
        sendMessage(message);
        userInput.value = "";
        userInput.focus();
      }
    });

    suggestionButtons.forEach(button => {
      button.addEventListener("click", function() {
        const message = button.dataset.message;
        sendMessage(message);
      });
    });
  </script>
</body>
</html>